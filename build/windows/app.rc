#include <windows.h>

// 在仓库根目录用 windres 编译（路径相对仓库根目录）
// 主程序图标（资源 ID 1 = IDI_ICON1，Windows 默认取最小 ID 的图标作为 exe 图标）
1 ICON "dist\\fileload.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "KoLoRang"
            VALUE "FileDescription", "FileLoad - SSH 云端目录映射本地盘"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "FileLoad"
            VALUE "LegalCopyright", "Copyright (C) KoLoRang"
            VALUE "OriginalFilename", "FileLoad.exe"
            VALUE "ProductName", "FileLoad"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
